<!DOCTYPE html>
<html>
<head>
  <style>
    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
    .container { max-width: 600px; margin: 0 auto; padding: 20px; }
    .header { background: #f59e0b; color: white; padding: 20px; text-align: center; border-radius: 8px 8px 0 0; }
    .content { padding: 20px; border: 1px solid #eee; border-top: none; border-radius: 0 0 8px 8px; }
    .btn { display: inline-block; padding: 10px 20px; background: #f59e0b; color: white; text-decoration: none; border-radius: 4px; margin-top: 20px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h2>Assignment Due Reminder</h2>
    </div>
    <div class="content">
      <p>Hello {{username}},</p>
      <p>Your assignment <strong>{{assignmentTitle}}</strong> for the classroom <strong>{{classroomName}}</strong> is due soon.</p>
      <p><strong>Due Date:</strong> {{dueDate}}</p>
      <p>Make sure you complete and submit it before the deadline to avoid late penalties.</p>
      <a href="{{assignmentUrl}}" class="btn">View Assignment</a>
    </div>
  </div>
</body>
</html>
